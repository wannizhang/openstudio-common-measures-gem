<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>ReportingMeasure</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
  <script type="text/javascript" src="http://cdnjs.cloudflare.com/ajax/libs/jquery/2.0.3/jquery.min.js"></script>
  <script src="https://code.highcharts.com/highcharts.js"></script>
  <script src="https://code.highcharts.com/highcharts-more.js"></script>
  <script src="https://code.highcharts.com/modules/exporting.js"></script>

  <style>
      /* Adjust section header styles for a more subtle appearance */
      .section-header {
        background-color: #f8f9fa; /* Light gray, subtle */
        color: #333; /* Dark text for contrast */
        border-bottom: 1px solid #dee2e6; /* Add subtle bottom border */
        cursor: pointer;
      }

      /* Chart container dynamic height placeholder */
      .chart-container {
          width: 100%;
          margin-bottom: 2rem;
      }

      /* Overall spacing and body background */
      body {
          background-color: #f7f7f7; /* Soft off-white background for better readability */
      }

      .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 1rem;
      }


      .section-header::after {
        content: '\25bc'; /* Unicode for downwards arrow: ▼ */
        font-size: 0.8rem;
        transition: transform 0.3s ease;
      }


      .section-header[aria-expanded="true"]::after {
        transform: rotate(-180deg);
      }


  </style>
</head>
<body>
<!-- Banner -->
<div class="text-center py-4" style="background-color: #e9ecef; color: #495057;">
  <h1 class="mb-0">Building Thermal Resilience Report</h1>
</div>

<div class="container my-4">
  <p>
    This report visualizes and summarizes some key thermal resilience metrics during the user-specified extreme event period.
    For more details about each metric, please refer to the
    <a href="https://bigladdersoftware.com/epx/docs/25-1/engineering-reference/resilience-metrics.html"
       target="_blank" rel="noopener noreferrer">EnergyPlus Resilience Metrics Documentation</a>.
  </p>

  <!-- Resilience Metrics Section -->
  <div class="card mb-4">
    <div class="card-header section-header" data-bs-toggle="collapse" data-bs-target="#resilienceChartGroup"
         aria-expanded="true" aria-controls="resilienceChartGroup">
      <h2 class="h5 mb-0">Thermal Resilience Metrics Visualization</h2>
    </div>
    <div class="card-body collapse show" id="resilienceChartGroup">

      <!-- Line Chart Group for each zone with section-header Toggle -->
      <div>
        <div class="section-header" data-bs-toggle="collapse" data-bs-target="#lineChartGroup" aria-expanded="true" aria-controls="lineChartGroup">
          <h5 class="mb-0">Line Chart for Each Zone</h5>
        </div>
        <div class="collapse show" id="lineChartGroup">
          <!-- Dropdown button to select zones -->
          <div class="m-3"> <!-- 1rem margin on all sides -->
            <div class="d-flex align-items-center">
              <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" type="button" id="zoneDropdownButton" data-bs-toggle="dropdown" aria-expanded="false">
                  Select Zones
                </button>
                <div class="dropdown-menu p-2" id="zoneDropdownMenu" style="min-width: 250px;">
                  <!-- Select All option -->
                  <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="selectAllZones" checked>
                    <label class="form-check-label fw-bold" for="selectAllZones">Select All</label>
                  </div>
                  <div class="dropdown-divider"></div>
                  <!-- Zone options will be dynamically generated here -->
                  <div id="zoneOptions"></div>
                </div>
              </div>
              <small class="text-muted ms-2" id="selectedZonesCount">Zone count here</small>
            </div>
          </div>
          <div id="line-chart-drybulb-temperature" class="chart-container"></div>
          <div id="line-chart-heat-index" class="chart-container"></div>
          <div id="line-chart-set" class="chart-container"></div>
        </div>
      </div>

      <!-- Box Chart Group for all zones with section-header Toggle -->
      <div>
        <div class="section-header" data-bs-toggle="collapse" data-bs-target="#boxChartGroup" aria-expanded="true" aria-controls="boxChartGroup">
          <h5 class="mb-0">Distribution for All Zones</h5>
        </div>
        <div class="collapse show" id="boxChartGroup">
          <div class="m-3">
            <div class="dropdown">
              <button class="btn btn-secondary dropdown-toggle" type="button" id="caseDropdownButton" data-bs-toggle="dropdown" aria-expanded="false">
                Select Case(s)
              </button>
              <div class="dropdown-menu p-2" id="caseDropdownMenu" style="min-width: 200px;">
                <!-- Target Case -->
                <div class="form-check">
                  <input class="form-check-input case-check" type="checkbox" id="targetCase" value="target" checked>
                  <label class="form-check-label" for="targetCase">Target Case</label>
                </div>
                <!-- Comparison Case -->
                <div class="form-check">
                  <input class="form-check-input case-check" type="checkbox" id="comparisonCase" value="comparison" checked>
                  <label class="form-check-label" for="comparisonCase">Comparison Case</label>
                </div>
              </div>
            </div>
          </div>
          <div id="box-chart-drybulb-temperature" class="chart-container"></div>
          <div id="box-chart-heat-index" class="chart-container"></div>
          <div id="box-chart-set" class="chart-container"></div>
        </div>
      </div>

    </div>
  </div>

  <!-- Resilience Metrics Summary Table -->
  <div class="card">
    <div class="card-header section-header" data-bs-toggle="collapse" data-bs-target="#metricTables" aria-expanded="true" aria-controls="metricTables">
      <h2 class="h5 mb-0">Thermal Resilience Metrics Summary</h2>
    </div>
    <div class="card-body collapse show" id="metricTables">
      <div class="table-responsive">
        <% if target_tables_html.any? %>
          <% target_tables_html.each do |table| %>
            <h5 class="mt-4"><%= table[:name].gsub(/<.?b>/, '') %></h5>
            <%= table[:content] %>
          <% end %>
        <% else %>
          <p>No data available for Thermal Resilience Metrics Summary.</p>
        <% end %>

      </div>
    </div>
  </div>

<!--   Energy Impact Section -->
  <div class="card">
    <div class="card-header section-header" data-bs-toggle="collapse" data-bs-target="#energyTables" aria-expanded="true" aria-controls="energyTables">
      <h2 class="h5 mb-0">Energy Impact</h2>
    </div>
    <div class="card-body collapse show" id="energyTables">
      <table class="table table-bordered table-hover">
        <thead class="thead-dark">
        <tr>
          <th>Metric</th>
          <th>Target Case</th>
          <th>Comparison Case</th>
          <th>Difference (%)</th>
        </tr>
        </thead>
        <tbody>
        <% energy_comparison.each do |metric, target, comparison| %>
          <tr>
            <td><%= metric %></td>
            <td><%= target %></td>
            <td><%= comparison %></td>
            <td><%= ((comparison - target) / target.to_f * 100).round(2) %> %</td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  Highcharts.setOptions({
    time: {
      useUTC: true
    }
  });
  function createXAxisWithBand(eventStartTime, eventEndTime, labelText = 'Extreme Event Duration',
                               bandColor = 'rgba(211,211,211,0.3)') {
    return {
      type: 'datetime',
      title: { text: 'Time' },
      labels: {
        formatter: function () {
          const date = new Date(this.value);
          return Highcharts.dateFormat('%m-%d', date) + '<br>' + Highcharts.dateFormat('%H:%M', date);
        },
        style: { whiteSpace: 'nowrap' }
      },
      // Plot band for the event period
      plotBands: [{
        from: eventStartTime,
        to: eventEndTime,
        color: bandColor,
        label: {text: labelText, style: {color: '#606060', fontWeight: 'bold'}},
        zIndex: 3
      }],
      // Plot left and right border of the band
      plotLines: [
        { // Left border
          color: '#9d9d9d', // Border color
          width: 2,         // Border width
          value: eventStartTime, // Position of the left border
          zIndex: 3         // Ensures it displays above the plotBand
        },
        { // Right border
          color: '#9d9d9d', // Border color
          width: 2,         // Border width
          value: eventEndTime,   // Position of the right border
          zIndex: 3         // Ensures it displays above the plotBand
        }
      ]

    };
  }
  // Plot line thresholds for different variables
  function createPlotLinesForVariable(variable) {
    if (variable === 'Zone Air Temperature') {
      // plot cold stress threshold for dry-bulb temperature
      return [
        {
          value: 16, color: '#3f8be1', // lighter blue
          dashStyle: 'ShortDash', width: 2,
          label: {
            text: 'Cold Stress Temperature Threshold for Healthy Population (16°C/60°F)',
            align: 'right',
            style: {color: '#3f8be1', fontWeight: 'bold'},
          },
        },
        {
          value: 18, color: '#1f43d3', // darker blue
          dashStyle: 'ShortDash', width: 2,
          label: {
            text: 'Cold Stress Temperature Threshold for Vulnerable Population (18°C/64°F)',
            align: 'right',
            style: {color: '#1f43d3', fontWeight: 'bold'},
          },
        },
      ];
    } else if (variable === 'Zone Thermal Comfort Pierce Model Standard Effective Temperature') {
      // plot livable temperature threshold for SET
      return [
        {
          value: 12, color: 'blue', dashStyle: 'ShortDash', width: 2,
          label: {
            text: 'Livable Temperature Threshold (12°C/54°F)',
            align: 'right',
            style: {color: 'blue', fontWeight: 'bold'},
          },
        },
        {
          value: 30, color: 'red', dashStyle: 'ShortDash', width: 2,
          label: {
            text: 'Livable Temperature Threshold (30°C/86°F)',
            align: 'right',
            style: {color: 'red', fontWeight: 'bold'},
          },
        },
      ];
    } else {
      // no threshold lines for other variables
      return [];
    }
  }
  ///////////////////////////////////////////////////////////////
  //////// For line plots for each zone
  ///////////////////////////////////////////////////////////////
  // Predefined colors for zones
  const zoneColors = Highcharts.getOptions().colors;
  // Data injected from Ruby (converted to JSON)
  const zones = <%= available_zone_names.to_json %>; // List of zones
  const zoneColorMap = {};
  zones.forEach((zone, index) => {
    zoneColorMap[zone] = zoneColors[index % zoneColors.length];
  });
  // Get the extreme event start and end time for plotting
  const eventStartTime = <%= event_start_time %>;
  const eventEndTime = <%= event_end_time %>;
  const outdoorTemperature = <%= outdoor_temperature_data.to_json %>
  const compareZoneData = <%= compare_zone_data.to_json %>; // Baseline data, optional
  const targetZoneData = <%= target_zone_data.to_json %>; // Measure data
  const comparisonProvided = <%= comparison_file_provided.to_json %>; // Boolean flag to check if baseline is provided
  // Dynamically generate dropdown menu options
  const zoneOptions = document.getElementById("zoneOptions");
  zones.forEach((zone, index) => {
    const option = document.createElement("div");
    option.className = "form-check";
    option.innerHTML = `
    <input class="form-check-input zone-option" type="checkbox" value="${zone}" id="zone_${index}" checked>
    <label class="form-check-label" for="zone_${index}">${zone}</label>
  `;
    zoneOptions.appendChild(option);
  });


  // Update selected zones count display
  function updateSelectedCount() {
    const selectedCount = document.querySelectorAll('.zone-option:checked').length;
    const totalCount = zones.length;
    document.getElementById('selectedZonesCount').textContent = `Selected ${selectedCount}/${totalCount} zones`;

    // Update select all checkbox state
    const selectAllCheckbox = document.getElementById('selectAllZones');
    selectAllCheckbox.checked = selectedCount === totalCount;
    selectAllCheckbox.indeterminate = selectedCount > 0 && selectedCount < totalCount;
  }


  // Converts data into Highcharts-compatible series
  // Dynamically handles whether baseline data is provided
  // Helper function to get the chart series based on selected zones
  function getSeriesData(variableKey) {
    const selectedZones = [...document.querySelectorAll(".zone-option:checked")]
      .map(input => input.value);
    console.log(selectedZones);

    let selected_series = [];
    selected_series.push({
      name: 'outdoor',
      data: outdoorTemperature,
      color: 'black',
      dashStyle: 'Solid',
      lineWidth: 2,
      marker: { enabled: false }
    });
    selectedZones.forEach((zone, index) => {
      if (comparisonProvided && compareZoneData[variableKey] && compareZoneData[variableKey][zone]) {
        // Highcharts will modify the data feed in, so deep copy the selected data
        const zoneDataCopy = JSON.parse(JSON.stringify(compareZoneData[variableKey][zone]));
        // Comparison series
        selected_series.push({
          name: `${zone} - Comparison Case`,
          data: zoneDataCopy,
          color: zoneColorMap[zone],
          dashStyle: 'Solid',
          lineWidth: 2,
          marker: { enabled: false }
        });
        console.log(zone, compareZoneData[variableKey][zone])
      }
      if (targetZoneData[variableKey] && targetZoneData[variableKey][zone]) {
        const zoneDataCopy = JSON.parse(JSON.stringify(targetZoneData[variableKey][zone]));
        // Target series
        selected_series.push({
          name: `${zone} - Target Case`,
          data: zoneDataCopy,
          color: zoneColorMap[zone],
          dashStyle: 'Dash',
          lineWidth: 2,
          marker: { enabled: false }
        });
      }
    });
    return selected_series;

  }


  // Dynamic chart height calculation
  const calculateChartHeight = () => {
    // Set chart height dynamically as 70% of the window height, with a minimum of 300px
    return Math.max(window.innerHeight * 0.8, 300);
  };

  // Chart 1: Zone Air Temperature
  const dryBulbChart = Highcharts.chart('line-chart-drybulb-temperature', {
    chart: {
      type: 'line',
      height: calculateChartHeight(), // Dynamically set chart height
      zoomType: 'xy' // Enable zoom functionality
    },
    title: { text: 'Air Dry-bulb Temperature Comparison' },
    xAxis: createXAxisWithBand(eventStartTime, eventEndTime),
    yAxis: {
      title: { text: 'Temperature (°C)' },
      plotLines: createPlotLinesForVariable('Zone Air Temperature')
    },
    tooltip: {
      xDateFormat: '%Y-%m-%d %H:%M', // Tooltip datetime format
      shared: true // Share tooltip across all data points
    },
    legend: {
      layout: 'horizontal', align: 'center', verticalAlign: 'bottom',
      maxHeight: calculateChartHeight()*0.2,
      navigation: {
        enabled: true
      }
    },
    series: getSeriesData('Zone Air Temperature'),
    exporting: {
      enabled: true,
      buttons: {
        contextButton: {
          menuItems: [
            'printChart',
            'separator',
            'downloadPNG',
            'downloadJPEG',
            'downloadPDF',
            'downloadSVG'
          ]
        }
      }
    }

  });

  // Chart 2: Zone Heat Index
  const heatIndexBands = [
    { from: -Infinity, to: 26.9, color: 'rgba(0, 255, 0, 0.5)', label: 'Normal' },  // < 27°C
    { from: 27, to: 33, color: 'rgba(255, 255, 0, 0.5)', label: 'Caution' },       // 27°C - 32°C
    { from: 33, to: 40, color: 'rgba(255, 165, 0, 0.5)', label: 'Warning' },       // 33°C - 39°C
    { from: 40, to: 52, color: 'rgba(255, 0, 0, 0.5)', label: 'Danger' },          // 40°C - 51°C
    { from: 52, to: Infinity, color: 'rgba(128, 0, 0, 0.5)', label: 'Extreme Danger' } // > 51°C
  ];

  const heatIndexChart = Highcharts.chart('line-chart-heat-index', {
    chart: {
      type: 'line',
      height: calculateChartHeight(), // Dynamically set chart height
      zoomType: 'xy' // Enable zoom functionality
    },
    title: { text: 'Heat Index Comparison' },
    xAxis: createXAxisWithBand(eventStartTime, eventEndTime),
    yAxis: {
      title: { text: 'Heat Index (°C)' },
      plotBands: heatIndexBands.map(band => ({
        from: band.from,
        to: band.to,
        color: band.color,
        label: {
          text: band.label,
          style: { color: '#000', fontWeight: 'bold' }
        },
        zIndex: 1
      }))
    },
    tooltip: {
      xDateFormat: '%Y-%m-%d %H:%M', // Tooltip datetime format
      shared: true // Share tooltip across all data points
    },
    legend: {
      layout: 'horizontal', align: 'center', verticalAlign: 'bottom',
      maxHeight: calculateChartHeight()*0.2,
      navigation: {
        enabled: true
      }
    },
    series: getSeriesData('Zone Heat Index'),
    exporting: {
      enabled: true,
      buttons: {
        contextButton: {
          menuItems: [
            'printChart',
            'separator',
            'downloadPNG',
            'downloadJPEG',
            'downloadSVG'
          ]
        }
      }
    }
  });

  // Chart 3: Zone Thermal Comfort Pierce Model Standard Effective Temperature (SET)
  const setChart = Highcharts.chart('line-chart-set', {
    chart: {
      type: 'line',
      height: calculateChartHeight(), // Dynamically set chart height
      zoomType: 'xy' // Enable zoom functionality
    },
    title: { text: 'Standard Effective Temperature (SET) Comparison' },
    xAxis: createXAxisWithBand(eventStartTime, eventEndTime),
    yAxis: {
      title: { text: 'SET (°C)' },
      // Add threshold lines for livable temperature
      plotLines: createPlotLinesForVariable('Zone Thermal Comfort Pierce Model Standard Effective Temperature')
    },
    tooltip: {
      xDateFormat: '%Y-%m-%d %H:%M', // Tooltip datetime format
      shared: true // Share tooltip across all data points
    },
    legend: {
      layout: 'horizontal', align: 'center', verticalAlign: 'bottom',
      maxHeight: calculateChartHeight()*0.2,
      navigation: {
        enabled: true
      }
    },
    series: getSeriesData('Zone Thermal Comfort Pierce Model Standard Effective Temperature'),
    exporting: {
      enabled: true,
      buttons: {
        contextButton: {
          menuItems: [
            'printChart',
            'separator',
            'downloadPNG',
            'downloadJPEG',
            'downloadSVG'
          ]
        }
      }
    }
  });


  // Select all / deselect all functionality
  document.getElementById("selectAllZones").addEventListener("change", function() {
    const isChecked = this.checked;
    document.querySelectorAll('.zone-option').forEach(checkbox => {
      checkbox.checked = isChecked;
    });
    updateSelectedCount();
    dryBulbChart.update({ series: getSeriesData('Zone Air Temperature') }, true, true);
    heatIndexChart.update({ series: getSeriesData('Zone Heat Index') }, true, true);
    setChart.update({ series: getSeriesData('Zone Thermal Comfort Pierce Model Standard Effective Temperature') }, true, true);
  });

  // Update charts and count when zone options change
  document.getElementById("zoneOptions").addEventListener("change", function(e) {
    if (e.target.classList.contains('zone-option')) {
      updateSelectedCount();
      dryBulbChart.update({ series: getSeriesData('Zone Air Temperature') }, true, true);
      heatIndexChart.update({ series: getSeriesData('Zone Heat Index') }, true, true);
      setChart.update({ series: getSeriesData('Zone Thermal Comfort Pierce Model Standard Effective Temperature') }, true, true);
    }
  });

  // Prevent dropdown menu from closing when clicking on its content
  document.getElementById('zoneDropdownMenu').addEventListener('click', function(e) {
    e.stopPropagation();
  });

  // Initialize selected zones count display
  updateSelectedCount();

  ///////////////////////////////
  // For box plots for all zones
  //////////////////////////////
  const targetBoxData = <%= boxplot_data_target.to_json %>;
  const comparisonBoxData = <%= boxplot_data_comparison.to_json %>;
  const boxTitles = {
    'Zone Air Temperature': 'All Zones Air Dry-bulb Temperature Distribution',
    'Zone Heat Index': 'All Zones Heat Index Distribution',
    'Zone Thermal Comfort Pierce Model Standard Effective Temperature': 'All Zones Standard Effective Temperature (SET) Distribution'
  }
  const boxYLabels = {
    'Zone Air Temperature': 'Temperature (°C)',
    'Zone Heat Index': 'Heat Index (°C)',
    'Zone Thermal Comfort Pierce Model Standard Effective Temperature': 'SET (°C)'
  }
  const activeCases = { target: true, comparison: true };
  // General function to plot all boxplots
  function renderBoxPlot(variable, containerId) {
    let seriesData = [];
    // construct data to plot based on selected cases
    if (activeCases.target) {
      seriesData.push({ name: 'Target Case', data: targetBoxData[variable] });
    }
    if (activeCases.comparison && Object.keys(comparisonBoxData).length > 0) {
      seriesData.push({ name: 'Comparison Case', data: comparisonBoxData[variable] });
    }
    let yBands;
    if (variable === 'Zone Heat Index'){
      yBands = heatIndexBands.map(band => ({
        from: band.from,
        to: band.to,
        color: band.color,
        label: {
          text: band.label,
          style: { color: '#000', fontWeight: 'bold' }
        },
        zIndex: 1
      }))
    }else{
      yBands = []
    }

    Highcharts.chart(containerId, {
      chart: {
        type: 'boxplot', // Boxplot chart type
        height: calculateChartHeight(), // Dynamically set chart height
        zoomType: 'xy' // Enable zoom functionality
      },
      title: {
        text: boxTitles[variable]
      },
      xAxis: createXAxisWithBand(eventStartTime, eventEndTime),
      yAxis: {
        title: {
          text: boxYLabels[variable]
        },
        plotBands: yBands,
        // Add threshold lines for livable temperature
        plotLines: createPlotLinesForVariable(variable)
      },
      series: seriesData.map(caseData => ({
        name: caseData.name, // Series name (e.g., Target Case or Comparison Case)
        data: caseData.data.map(item => ({
          x: item.datetime, // Convert datetime string to timestamp
          low: item.data[0],  // Minimum value
          q1: item.data[1],   // Q1 value
          median: item.data[2],   // Median value
          q3: item.data[3],   // Q3 value
          high: item.data[4]  // Maximum value
        })),
        tooltip: {
          headerFormat: '<b>{series.name} - {point.x:%Y-%m-%d %H:%M:%S}</b><br/>', // Use formatted datetime
          pointFormat: 'Max: {point.high}<br/>Q3: {point.q3}<br/>Median: {point.median}<br/>Q1: {point.q1}<br/>Min: {point.low}',
        }
      })),
      tooltip: {
        useHTML: true
      },
      exporting: {
        enabled: true,
        buttons: {
          contextButton: {
            menuItems: [
              'printChart',
              'separator',
              'downloadPNG',
              'downloadJPEG',
              'downloadSVG'
            ]
          }
        }
      }
    });
  }

  function renderAllBoxPlots() {
    renderBoxPlot('Zone Air Temperature', 'box-chart-drybulb-temperature');
    renderBoxPlot('Zone Heat Index', 'box-chart-heat-index');
    renderBoxPlot('Zone Thermal Comfort Pierce Model Standard Effective Temperature', 'box-chart-set');
  }
  renderAllBoxPlots();

  // Update selected cases
  document.querySelectorAll('.case-check').forEach(checkbox => {
    checkbox.addEventListener('change', function () {
      const caseType = this.value; // "target" or "comparison"
      activeCases[caseType] = this.checked;
      renderAllBoxPlots();
    });
  });



  // Resize charts dynamically when window size changes
  const resizeCharts = () => {
    document.querySelectorAll('.chart-container').forEach(chartContainer => {
      // Find the chart by its container ID
      const chartId = chartContainer.id;
      const chart = Highcharts.charts.find(c => c && c.renderTo.id === chartId);
      if (chart) {
        chart.setSize(null, calculateChartHeight(), false); // Adjust height dynamically
      }
    });
  };

  // Initial chart resizing logic
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.chart-container').forEach(chartContainer => {
      const chartId = chartContainer.id;
      const chart = Highcharts.charts.find(c => c && c.renderTo.id === chartId);
      if (chart) {
        chart.setSize(null, calculateChartHeight(), false); // Set dynamic height on load
      }
    });

    // Add an event listener for window resize adjustments
    window.addEventListener('resize', resizeCharts);

  });
</script>

</body>
</html>